use flake # refinator's own devenv flake, unmodified

# Pin to a commit SHA (not a branch) so this is reproducible 
nvimx_flake="github:allen-liaoo/nvimx/<commit-sha>?dir=projs/refinator"

cache_file="$(direnv_layout_dir)/nvimx_out"

if [[ "$(head -1 "$cache_file" 2>/dev/null)" != "$nvimx_flake" ]]; then
  out_path=$(nix build "$nvimx_flake" --no-link --print-out-paths)
  printf '%s\n%s\n' "$nvimx_flake" "$out_path" > "$cache_file"
fi

PATH_add "$(tail -1 "$cache_file")/bin"
