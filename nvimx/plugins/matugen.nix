# Colorscheme from wallpaper colors generated by matugen
# https://github.com/daedlock/matugen.nvim
{
  config,
  inputs,
  lib,
  pkgs,
  ...
}:

{
  imports = [
    (lib.nixvim.plugins.mkNeovimPlugin {
      name = "matugen";
      url = "https://github.com/daedlock/matugen.nvim";
      isColorscheme = true;
      maintainers = [ ];
      # not in nixpkgs; set below since `pkgs` and `inputs` are unavailable in `imports`
      package = lib.mkOption {
        type = lib.types.package;
        description = "The matugen.nvim package to use.";
      };
      settingsExample = {
        colors_path = "~/.config/matugen/colors.json";
        brightness = 0.03;
        harmonize = 15;
      };
    })
  ];

  options.nvimx.matugen.enable = lib.mkEnableOption "matugen colorscheme";

  config = lib.mkMerge [
    {
      colorschemes.matugen.package = lib.mkDefault (pkgs.vimUtils.buildVimPlugin {
        name = "matugen";
        src = inputs.matugen-nvim;
      });
    }

    (lib.mkIf config.nvimx.matugen.enable {
      # replaces whichever colorscheme was chosen, so only matugen is enabled
      nvimx.colorscheme = lib.mkForce "matugen";
      # defaults to `colorscheme`, but bat has no matugen theme
      plugins.telescope.highlightTheme = lib.mkDefault null;

      plugins.lualine = {
        # `colorscheme matugen` runs before lualine.setup(), so the palette is loaded
        settings.options.theme = lib.nixvim.mkRaw "require('matugen').lualine()";
        # follow wallpaper changes, keeping the rest of the lualine config
        luaConfig.post = ''
          vim.api.nvim_create_autocmd("User", {
            pattern = "MatugenReloaded",
            callback = function()
              local lualine = require("lualine")
              local cfg = lualine.get_config()
              cfg.options.theme = require("matugen").lualine()
              lualine.setup(cfg)
            end,
          })
        '';
      };
    })
  ];
}
