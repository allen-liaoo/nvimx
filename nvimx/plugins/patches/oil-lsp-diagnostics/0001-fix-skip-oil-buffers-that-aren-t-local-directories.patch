From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Allen Liao <wcliaw610@gmail.com>
Date: Wed, 18 Nov 2026 13:39:10 -0500
Subject: [PATCH 1/2] fix: skip oil buffers that aren't local directories

oil.get_current_dir() returns nil for other adapters (trash, SSH, S3),
and building entry paths from it threw "attempt to concatenate local
'dir' (a nil value)" whenever such a buffer listed an entry.
---
 lua/oil-lsp-diagnostics.lua | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/lua/oil-lsp-diagnostics.lua b/lua/oil-lsp-diagnostics.lua
index d45773a..bfc8858 100644
--- a/lua/oil-lsp-diagnostics.lua
+++ b/lua/oil-lsp-diagnostics.lua
@@ -70,8 +70,13 @@ end
 local function add_lsp_extmarks(buffer)
     vim.api.nvim_buf_clear_namespace(buffer, namespace, 0, -1)
 
+    -- Only local directories have one: not the trash, SSH, S3, ...
+    local dir = oil.get_current_dir(buffer)
+    if not dir then
+        return
+    end
+
     for n = 1, vim.api.nvim_buf_line_count(buffer) do
-        local dir = oil.get_current_dir(buffer)
         local entry = oil.get_entry_on_line(buffer, n)
         local is_dir = entry and entry.type == "directory" or false
         local diagnostics
